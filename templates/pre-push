#!/usr/bin/env python3
"""Local pre-push scan. Push is the publish point on a public repo.

CI runs after a commit is already public, and a public commit is not cleanly
reversible, so this has to run before push. It scans every outgoing commit, not
just the tip: a secret added then removed still publishes.

Install: copy to .git/hooks/pre-push and chmod +x.
Private terms: one per line in .git/info/factory-private-names. That file lives
inside .git so it can never be committed. Findings name the rule and file, never
the matched text.
"""
import os
import re
import subprocess
import sys
import tempfile

ZERO = "0" * 40
FILE_RULES = [
    ("env file", re.compile(r"(?:^|/)\.env(?:\.(?!example$|sample$|template$)[^/]+)?$")),
    ("private key file", re.compile(r"(?:^|/)(?:id_rsa|id_ed25519|.*\.pem|.*\.key|.*\.p12)$")),
    ("credentials file", re.compile(r"(?:^|/)(?:credentials\.json|service-account.*\.json|\.npmrc|\.pypirc)$")),
]
SECRET_RULES = [
    ("AWS access key", re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("GitHub token", re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{40,})\b")),
    ("Anthropic key", re.compile(r"\bsk-ant-[A-Za-z0-9_-]{20,}")),
    ("OpenAI-style key", re.compile(r"\bsk-(?:proj-)?[A-Za-z0-9_-]{32,}")),
    ("Slack token", re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{20,}")),
    ("private key block", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("assigned secret", re.compile(
        r"""(?i)\b(?:api[_-]?key|secret|token|passw(?:or)?d)\b["']?\s*[:=]\s*["'][^"'\s]{16,}["']""")),
]


def git(repo, *args):
    result = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True,
                            encoding="utf-8", errors="replace", check=False)
    if result.returncode != 0:
        raise RuntimeError(f"git {args[0]} failed")
    return result.stdout


def outgoing(repo, local_sha, remote_sha):
    """rev-list arguments for what this push would publish."""
    if remote_sha != ZERO:
        try:
            git(repo, "cat-file", "-e", f"{remote_sha}^{{commit}}")
            return [local_sha, f"^{remote_sha}"]
        except RuntimeError:
            pass
    return [local_sha, "--not", "--remotes"]


def private_terms(repo):
    path = git(repo, "rev-parse", "--git-path", "info/factory-private-names").strip()
    path = path if os.path.isabs(path) else os.path.join(repo, path)
    if not os.path.exists(path):
        return []
    with open(path, encoding="utf-8") as handle:
        return [t.strip().casefold() for t in handle if t.strip() and not t.startswith("#")]


def scan(repo, local_sha, remote_sha):
    """Return a sorted list of (rule, location) findings."""
    span = outgoing(repo, local_sha, remote_sha)
    terms = private_terms(repo)
    findings = set()
    names = git(repo, "log", "-m", "--no-renames", "--name-only", "--diff-filter=d",
                "--format=", "-z", *span)
    for name in filter(None, names.replace("\n", "\0").split("\0")):
        for rule, pattern in FILE_RULES:
            if pattern.search(name):
                findings.add((rule, name))
        if any(t in name.casefold() for t in terms):
            findings.add(("private name in path", name))
    current = "(unknown file)"
    patch = git(repo, "log", "-m", "--no-renames", "--no-color", "--no-ext-diff", "--no-textconv",
                "-U0", "-p", "--format=", *span)
    for line in patch.split("\n"):
        if line.startswith("+++ b/"):
            current = line[6:]
        elif line.startswith("+") and not line.startswith("+++ "):
            for rule, pattern in SECRET_RULES:
                if pattern.search(line):
                    findings.add((rule, current))
            if any(t in line.casefold() for t in terms):
                findings.add(("private name in content", current))
    for line in git(repo, "log", "--format=%B", *span).split("\n"):
        for rule, pattern in SECRET_RULES:
            if pattern.search(line):
                findings.add((rule, "(commit message)"))
        if any(t in line.casefold() for t in terms):
            findings.add(("private name in commit message", "(commit message)"))
    return sorted(findings)


def main():
    if "--selftest" in sys.argv:
        return selftest()
    repo = os.getcwd()
    found = []
    try:
        for line in sys.stdin:
            parts = line.split()
            if len(parts) == 4 and parts[1] != ZERO:
                found += scan(repo, parts[1], parts[3])
    except RuntimeError as exc:
        print(f"pre-push: scan could not run ({exc}); blocking push", file=sys.stderr)
        return 1
    if found:
        print("pre-push: blocked, this push would publish:", file=sys.stderr)
        for rule, where in sorted(set(found)):
            print(f"  {rule}: {where}", file=sys.stderr)
        print("Rewrite the commits that added it. Removing it in a new commit still publishes it.",
              file=sys.stderr)
        return 1
    return 0


def selftest():
    failed = 0

    def check(name, ok):
        nonlocal failed
        failed += 0 if ok else 1
        print("ok  " if ok else "FAIL", name)

    # Built by concatenation so this file does not trip scanners itself.
    aws = "AKIA" + "ABCDEFGHIJKLMNOP"
    with tempfile.TemporaryDirectory() as repo:
        def run(*args):
            subprocess.run(["git", "-C", repo, "-c", "user.name=t", "-c", "user.email=t@example.com",
                            "-c", "commit.gpgsign=false", *args], check=True, capture_output=True)

        def commit(path, text, message="change"):
            full = os.path.join(repo, path)
            os.makedirs(os.path.dirname(full), exist_ok=True)
            with open(full, "w", encoding="utf-8") as handle:
                handle.write(text)
            run("add", "-A")
            run("commit", "-m", message)
            return git(repo, "rev-parse", "HEAD").strip()

        run("init", "-q")
        base = commit("README.md", "hello\n")
        check("clean commit passes", scan(repo, commit("a.txt", "fine\n"), base) == [])
        tip = commit("b.txt", f"key {aws}\n")
        check("secret in content is caught", ("AWS access key", "b.txt") in scan(repo, tip, base))
        tip = commit("b.txt", "removed\n")
        check("HOSTILE secret added then removed is still caught", ("AWS access key", "b.txt") in scan(repo, tip, base))
        base = tip
        tip = commit(".env", "A=1\n")
        check("env file name is caught", ("env file", ".env") in scan(repo, tip, base))
        base = tip
        check("env example is allowed", scan(repo, commit(".env.example", "A=\n"), base) == [])
        base = git(repo, "rev-parse", "HEAD").strip()
        check("key in commit message is caught", any(w == "(commit message)" for _, w in scan(repo, commit("c.txt", "x\n", f"oops {aws}"), base)))
        base = git(repo, "rev-parse", "HEAD").strip()
        with open(os.path.join(repo, ".git", "info", "factory-private-names"), "w", encoding="utf-8") as handle:
            handle.write("# local list\nJane Example\n")
        tip = commit("d.txt", "met jane example today\n")
        found = scan(repo, tip, base)
        check("private term in content is caught", ("private name in content", "d.txt") in found)
        check("output never prints the private term", "jane" not in repr(found).lower())
        base = tip
        tip = commit("notes/jane example.txt", "x\n")
        check("private term in a path is caught", ("private name in path", "notes/jane example.txt") in scan(repo, tip, base))
        check("new branch with no remote scans all commits", any(r == "AWS access key" for r, _ in scan(repo, tip, ZERO)))
        try:
            scan(repo, "f" * 40, ZERO)
            check("unknown commit fails closed", False)
        except RuntimeError:
            check("unknown commit fails closed", True)
    print(f"pre-push selftest: {'FAILED ' + str(failed) if failed else 'passed'}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
